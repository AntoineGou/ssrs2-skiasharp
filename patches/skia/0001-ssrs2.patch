-    return ToDocument(SkPDF::MakeDocument(AsWStream(stream), AsDocumentPDFMetadata(cmetadata)).release());
+    return ToDocument(SkPDF::MakeDocument(AsWStream(stream), FastestDeflate(AsDocumentPDFMetadata(cmetadata))).release());
 }
 
