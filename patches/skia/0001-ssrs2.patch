+// SSRS2: a PDF's streams (page content, forms, fonts) deflated at zlib's fastest level, not its default: the bindings
+// have no setting for it, and the default made deflating a document's pages a large part of writing it.
+static SkPDF::Metadata FastestDeflate(SkPDF::Metadata metadata) {
+    metadata.fCompressionLevel = SkPDF::Metadata::CompressionLevel::LowButFast;
+    return metadata;
+}
