+static bool is_ascending(const uint32_t* clusters, uint32_t count) {
+    for (uint32_t i = 0; i + 1 < count; ++i) {
+        if (clusters[i + 1] < clusters[i]) {
+            return false;
+        }
+    }
+    return true;
+}
