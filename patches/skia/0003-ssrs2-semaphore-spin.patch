+// SSRS2: a short wait before sleeping. A count that comes back above zero while the thread spins is taken as try_wait
+// takes it (a count above zero means no thread sleeps: a thread spinning never takes a unit a sleeper was woken for).
+// SkMutex is this semaphore: its waiters slept at once, and a lock held for a moment by threads taking it in turn (a glyph
+// strike's, the glyph cache's) made each of them wait for a wakeup that took longer than the lock was held. The spin is
+// a few microseconds: x86's pause is some tens of nanoseconds, ARM's isb a few.
+#if defined(_M_X64) || defined(_M_IX86) || defined(__x86_64__) || defined(__i386__)
+static constexpr int kSkSemaphoreSpins = 200;
+#else
+static constexpr int kSkSemaphoreSpins = 1000;
+#endif
+static inline void sk_semaphore_relax() {
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    _mm_pause();
+#elif defined(_MSC_VER) && (defined(_M_ARM64) || defined(_M_ARM))
+    __yield();
+#elif defined(__x86_64__) || defined(__i386__)
+    __builtin_ia32_pause();
+#elif defined(__aarch64__) || defined(__arm__)
+    __asm__ __volatile__("isb" ::: "memory");
+#endif
+}
+
